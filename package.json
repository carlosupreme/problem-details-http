{
  "name": "problem-details-http",
  "version": "2.0.0",
  "description": "return http errors as stated in the document Problem Details for HTTP APIs RFC7807",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "cjs",
      "esm"
    ],
    "dts": true,
    "sourcemap": true,
    "minify": true,
    "splitting": true,
    "clean": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublish": "tsc"
  },
  "keywords": [
    "problem-details",
    "errors",
    "http",
    "http-errors",
    "api-errors"
  ],
  "author": "Carlos Sosa",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^2.0.5"
  },
  "repository": {
    "url": "https://github.com/carlosupreme/problem-details-http.git"
  }
}
